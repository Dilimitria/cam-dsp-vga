--synthesis_resources = lut 8 
SUBDESIGN decode_rsa
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[7..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[7..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode2380w[3..0]	: WIRE;
	w_anode2397w[3..0]	: WIRE;
	w_anode2407w[3..0]	: WIRE;
	w_anode2417w[3..0]	: WIRE;
	w_anode2427w[3..0]	: WIRE;
	w_anode2437w[3..0]	: WIRE;
	w_anode2447w[3..0]	: WIRE;
	w_anode2457w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[7..0] = eq_wire[7..0];
	eq_wire[] = ( w_anode2457w[3..3], w_anode2447w[3..3], w_anode2437w[3..3], w_anode2427w[3..3], w_anode2417w[3..3], w_anode2407w[3..3], w_anode2397w[3..3], w_anode2380w[3..3]);
	w_anode2380w[] = ( (w_anode2380w[2..2] & (! data_wire[2..2])), (w_anode2380w[1..1] & (! data_wire[1..1])), (w_anode2380w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2397w[] = ( (w_anode2397w[2..2] & (! data_wire[2..2])), (w_anode2397w[1..1] & (! data_wire[1..1])), (w_anode2397w[0..0] & data_wire[0..0]), enable_wire);
	w_anode2407w[] = ( (w_anode2407w[2..2] & (! data_wire[2..2])), (w_anode2407w[1..1] & data_wire[1..1]), (w_anode2407w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2417w[] = ( (w_anode2417w[2..2] & (! data_wire[2..2])), (w_anode2417w[1..1] & data_wire[1..1]), (w_anode2417w[0..0] & data_wire[0..0]), enable_wire);
	w_anode2427w[] = ( (w_anode2427w[2..2] & data_wire[2..2]), (w_anode2427w[1..1] & (! data_wire[1..1])), (w_anode2427w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2437w[] = ( (w_anode2437w[2..2] & data_wire[2..2]), (w_anode2437w[1..1] & (! data_wire[1..1])), (w_anode2437w[0..0] & data_wire[0..0]), enable_wire);
	w_anode2447w[] = ( (w_anode2447w[2..2] & data_wire[2..2]), (w_anode2447w[1..1] & data_wire[1..1]), (w_anode2447w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode2457w[] = ( (w_anode2457w[2..2] & data_wire[2..2]), (w_anode2457w[1..1] & data_wire[1..1]), (w_anode2457w[0..0] & data_wire[0..0]), enable_wire);
